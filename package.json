{
  "name": "smartdorm",
  "version": "1.0.0",
  "private": true,
  "description": "SmartDorm dormitory booking and management system",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:deploy": "npm --prefix backend run db:deploy",
    "db:seed": "npm --prefix backend run db:seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bestt5678/SmartDorm.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "homepage": "https://github.com/Bestt5678/SmartDorm#readme",
  "bugs": {
    "url": "https://github.com/Bestt5678/SmartDorm/issues"
  }
}
