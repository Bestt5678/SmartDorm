{
  "name": "smartdorm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SmartDorm dormitory booking and management API",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "pg": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
