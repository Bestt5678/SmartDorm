DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartdorm?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
UPLOAD_DIR="uploads"
APP_TIMEZONE="Asia/Bangkok"

# --- OAuth (ไม่บังคับ) ใส่ทั้ง ID และ SECRET ของ provider ไหน ปุ่มนั้นจะขึ้นที่หน้าเข้าสู่ระบบ ---
# URL ของหน้าเว็บ (หลังล็อกอินสำเร็จ backend จะ redirect ไปที่ FRONTEND_URL/auth/callback)
FRONTEND_URL="http://localhost:5173"
# ฐานของ callback URL ที่ต้องลงทะเบียนไว้กับ provider: <OAUTH_CALLBACK_BASE_URL>/auth/<provider>/callback
# เช่น http://localhost:5173/api/auth/google/callback
OAUTH_CALLBACK_BASE_URL="http://localhost:5173/api"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
