generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model RoomType {
  room_type_id Int      @id @default(autoincrement())
  type_name    String   @db.VarChar(50)
  base_price   Decimal  @db.Decimal(10, 2)
  description  String?
  image_urls   String[] @default([])
  amenities    String[] @default([])
  rooms        Room[]

  @@map("room_type")
}

model Room {
  room_id        Int             @id @default(autoincrement())
  room_number    String          @unique @db.VarChar(10)
  floor          Int
  room_type_id   Int
  monthly_rate   Decimal         @db.Decimal(10, 2)
  status         String          @default("ว่าง") @db.VarChar(20)
  room_type      RoomType        @relation(fields: [room_type_id], references: [room_type_id], onDelete: Restrict, onUpdate: Cascade)
  bookings       Booking[]
  utility_meters UtilityMeter[]
  repairs        RepairRequest[]

  @@index([room_type_id])
  @@index([status])
  @@map("room")
}

model Tenant {
  tenant_id  Int       @id @default(autoincrement())
  full_name  String    @db.VarChar(100)
  id_card_no String    @unique @db.VarChar(13)
  phone      String?   @db.VarChar(10)
  email      String?   @db.VarChar(100)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  bookings   Booking[]
  account    Account?

  @@map("tenant")
}

model Booking {
  booking_id   Int       @id @default(autoincrement())
  room_id      Int
  tenant_id    Int
  booking_date DateTime  @default(now()) @db.Date
  move_in_date DateTime  @db.Date
  status       String    @default("รอดำเนินการ") @db.VarChar(20)
  room         Room      @relation(fields: [room_id], references: [room_id], onDelete: Restrict, onUpdate: Cascade)
  tenant       Tenant    @relation(fields: [tenant_id], references: [tenant_id], onDelete: Restrict, onUpdate: Cascade)
  contract     Contract?

  @@index([room_id, status])
  @@index([tenant_id])
  @@map("booking")
}

model Contract {
  contract_id Int       @id @default(autoincrement())
  booking_id  Int       @unique
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  deposit     Decimal   @db.Decimal(10, 2)
  booking     Booking   @relation(fields: [booking_id], references: [booking_id], onDelete: Restrict, onUpdate: Cascade)
  invoices    Invoice[]

  @@map("contract")
}

model Staff {
  staff_id  Int             @id @default(autoincrement())
  full_name String          @db.VarChar(100)
  position  String          @db.VarChar(50)
  phone     String?         @db.VarChar(10)
  repairs   RepairRequest[]
  account   Account?

  @@map("staff")
}

model UtilityMeter {
  meter_id      Int       @id @default(autoincrement())
  room_id       Int
  meter_month   DateTime  @db.Date
  water_unit    Decimal   @default(0) @db.Decimal(10, 2)
  electric_unit Decimal   @default(0) @db.Decimal(10, 2)
  room          Room      @relation(fields: [room_id], references: [room_id], onDelete: Restrict, onUpdate: Cascade)
  invoices      Invoice[]

  @@unique([room_id, meter_month], map: "uq_meter_room_month")
  @@map("utility_meter")
}

model Invoice {
  invoice_id      Int           @id @default(autoincrement())
  contract_id     Int
  meter_id        Int?          @unique
  invoice_date    DateTime      @default(now()) @db.Date
  due_date        DateTime      @db.Date
  rent_amount     Decimal       @default(0) @db.Decimal(10, 2)
  water_amount    Decimal       @default(0) @db.Decimal(10, 2)
  electric_amount Decimal       @default(0) @db.Decimal(10, 2)
  deposit_amount  Decimal       @default(0) @db.Decimal(10, 2)
  total_amount    Decimal?      @ignore @db.Decimal(10, 2)
  status          String        @default("ค้างชำระ") @db.VarChar(20)
  invoice_type    String        @default("RENT") @db.VarChar(20)
  contract        Contract      @relation(fields: [contract_id], references: [contract_id], onDelete: Restrict, onUpdate: Cascade)
  meter           UtilityMeter? @relation(fields: [meter_id], references: [meter_id], onDelete: SetNull, onUpdate: Cascade)
  payments        Payment[]

  @@index([contract_id])
  @@index([status])
  @@index([invoice_date])
  @@index([due_date])
  @@map("invoice")
}

model Payment {
  payment_id             Int       @id @default(autoincrement())
  invoice_id             Int
  payment_date           DateTime  @default(now()) @db.Date
  amount                 Decimal   @db.Decimal(10, 2)
  payment_type           String    @db.VarChar(20)
  status                 String    @default("อนุมัติแล้ว") @db.VarChar(20)
  slip_url               String?   @db.VarChar(255)
  note                   String?   @db.VarChar(500)
  verified_by_account_id Int?
  verified_at            DateTime? @db.Timestamp(6)
  invoice                Invoice   @relation(fields: [invoice_id], references: [invoice_id], onDelete: Restrict, onUpdate: Cascade)
  verified_by            Account?  @relation("PaymentVerifier", fields: [verified_by_account_id], references: [account_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([invoice_id])
  @@index([status])
  @@index([payment_date])
  @@map("payment")
}

model RepairRequest {
  repair_id    Int      @id @default(autoincrement())
  room_id      Int
  staff_id     Int?
  request_date DateTime @default(now()) @db.Date
  description  String
  status       String   @default("รอดำเนินการ") @db.VarChar(20)
  room         Room     @relation(fields: [room_id], references: [room_id], onDelete: Restrict, onUpdate: Cascade)
  staff        Staff?   @relation(fields: [staff_id], references: [staff_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([room_id])
  @@index([staff_id])
  @@index([status])
  @@map("repair_request")
}

model Account {
  account_id        Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(100)
  password_hash     String    @db.VarChar(255)
  role              String    @default("TENANT") @db.VarChar(20)
  tenant_id         Int?      @unique
  staff_id          Int?      @unique
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  tenant            Tenant?   @relation(fields: [tenant_id], references: [tenant_id], onDelete: SetNull, onUpdate: Cascade)
  staff             Staff?    @relation(fields: [staff_id], references: [staff_id], onDelete: SetNull, onUpdate: Cascade)
  verified_payments Payment[] @relation("PaymentVerifier")

  @@map("account")
}
